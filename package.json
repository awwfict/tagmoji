{
  "name": "tagmojis",
  "displayName": "🦄 tagmoji",
  "description": "Say 'hello' to tags right on your files!",
  "version": "0.1.0",
"publisher": "local-tools",
"repository": {
  "type": "git",
  "url": "https://github.com/awwfict/tagmoji.git"
},
"engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./uni.js",
  "contributes": {
    "commands": [
      {
        "command": "tagmoji.start",
        "title": "🦄 tagmoji"
      },
      {
        "command": "tagmoji.assign",
        "title": "🔖 tag"
      },
      {
        "command": "tagmoji.manage",
        "title": "✂️ manage"
      },
      {
        "command": "tagmoji.remove",
        "title": "🧽 untag"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tagmoji.assign",
          "group": "navigation@8"
        },
        {
          "command": "tagmoji.remove",
          "group": "navigation@9"
        }
      ]
    }
  }
}
